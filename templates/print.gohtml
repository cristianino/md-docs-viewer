<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{.Brand.CompanyName}} — {{.Brand.DocsTitle}}</title>
  <script src="/assets/mermaid.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
      color: #2d3748; background: #ffffff;
      font-size: 13.5px; line-height: 1.65;
    }

    /* PORTADA */
    .cover {
      height: 297mm;
      display: flex; flex-direction: column;
      justify-content: center; align-items: center; text-align: center;
      padding: 40px;
    }
    .cover-logo { margin-bottom: 44px; }
    .cover-logo img { max-height: 90px; width: auto; }
    .cover-company { font-size: 2rem; font-weight: 800; color: {{.Brand.PrimaryColor}}; margin-bottom: 10px; }
    .cover-title { font-size: 1.2rem; font-weight: 400; color: #4a5568; margin-bottom: 36px; }
    .cover-description { font-size: 0.95rem; color: #718096; max-width: 120mm; margin: -24px auto 36px; }
    .cover-line { width: 72px; height: 4px; background: {{.Brand.AccentColor}}; border-radius: 2px; margin: 0 auto 36px; }
    .cover-date { font-size: 0.85rem; color: #718096; margin-bottom: 12px; }
    .cover-powered { font-size: 0.8rem; color: #a0aec0; }
    .cover-powered a { color: {{.Brand.AccentColor}}; text-decoration: none; }

    /* ÍNDICE */
    .cover + .toc-page { break-before: page; }
    .toc-page { padding: 10px 0; }
    .toc-heading {
      font-size: 1.5rem; font-weight: 800; color: {{.Brand.PrimaryColor}};
      border-bottom: 3px solid {{.Brand.AccentColor}};
      padding-bottom: 12px; margin-bottom: 22px;
    }
    .toc-doc { padding: 10px 0 8px; border-bottom: 1px solid #edf2f7; break-inside: avoid; }
    .toc-doc:last-child { border-bottom: none; }
    .toc-item, .toc-sub-item {
      display: flex; align-items: baseline; gap: 10px;
      text-decoration: none; color: inherit;
    }
    .toc-num { font-size: 1.15rem; font-weight: 800; color: {{.Brand.AccentColor}}; min-width: 30px; }
    .toc-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .toc-title { font-size: 0.95rem; font-weight: 700; color: {{.Brand.PrimaryColor}}; }
    .toc-subtitle { font-size: 0.8rem; color: #718096; }
    .toc-dots { flex: 1; border-bottom: 1px dotted #cbd5e0; transform: translateY(-3px); min-width: 20px; }
    .toc-pg { min-width: 22px; text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; color: #4a5568; font-size: 0.85rem; }
    .toc-sub { margin: 4px 0 0 40px; }
    .toc-sub-item { font-size: 0.82rem; color: #4a5568; padding: 2px 0; }
    .toc-sub-item.lvl-3 { padding-left: 16px; font-size: 0.78rem; color: #718096; }
    .toc-sub-item .toc-pg { font-weight: 400; color: #718096; }

    /* SECCIONES */
    .doc-section { break-before: page; }
    .doc-header {
      background: {{.Brand.PrimaryColor}}; color: #ffffff; padding: 20px 28px; margin-bottom: 30px;
      display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;
    }
    .doc-header-title { font-size: 1.3rem; font-weight: 800; margin-bottom: 4px; line-height: 1.25; }
    .doc-header-subtitle { font-size: 0.88rem; opacity: 0.7; }
    .doc-header-back { color: #ffffff; opacity: 0.65; font-size: 0.75rem; text-decoration: none; white-space: nowrap; padding-top: 4px; }

    /* TIPOGRAFÍA */
    .content .md-h1 {
      font-size: 1.6rem; font-weight: 800; color: {{.Brand.PrimaryColor}};
      padding-bottom: 11px; border-bottom: 3px solid {{.Brand.AccentColor}};
      margin: 24px 0 10px; line-height: 1.25;
    }
    .content .md-h1:first-child { margin-top: 0; }
    .content .md-h2 {
      font-size: 1.15rem; font-weight: 700; color: {{.Brand.PrimaryColor}};
      margin: 30px 0 11px; padding-bottom: 7px; border-bottom: 1px solid #e2e8f0;
    }
    .content .md-h3 { font-size: 1.02rem; font-weight: 700; color: #2d3748; margin: 20px 0 7px; }
    .content .md-h4 { font-size: 0.95rem; font-weight: 600; color: #4a5568; margin: 14px 0 5px; }
    .content p { line-height: 1.75; color: #4a5568; margin-bottom: 11px; }
    .content strong { color: #2d3748; font-weight: 700; }
    .content em { color: #718096; }
    .content a { color: {{.Brand.AccentColor}}; text-decoration: none; }
    .content ul, .content ol { padding-left: 24px; margin-bottom: 11px; }
    .content li { line-height: 1.7; color: #4a5568; margin-bottom: 3px; }
    .content li p { margin-bottom: 3px; }
    .content hr { border: none; border-top: 2px solid #e2e8f0; margin: 26px 0; }
    .content blockquote {
      border-left: 4px solid {{.Brand.AccentColor}};
      background: {{.AccentFaint}};
      padding: 11px 15px; border-radius: 0 6px 6px 0;
      margin: 14px 0; color: #4a5568; font-size: 13px; break-inside: avoid;
    }
    .content blockquote p { margin-bottom: 0; }
    .content table {
      width: 100%; border-collapse: collapse;
      margin: 16px 0; font-size: 12px; break-inside: avoid;
    }
    .content th {
      background: {{.Brand.PrimaryColor}}; color: #ffffff;
      padding: 8px 11px; text-align: left;
      font-size: 10px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.05em;
    }
    .content td { padding: 8px 11px; border-bottom: 1px solid #edf2f7; color: #4a5568; vertical-align: top; }
    .content tr:last-child td { border-bottom: none; }
    .content tr:nth-child(even) td { background: #f7fafc; }
    .content code {
      font-family: 'Cascadia Code','Fira Code',Consolas,monospace;
      font-size: 11.5px; background: #edf2f7;
      color: {{.Brand.AccentColor}}; padding: 2px 5px; border-radius: 3px;
    }
    .content pre {
      background: #1a202c; border-radius: 7px;
      padding: 17px; overflow-x: auto; margin: 12px 0; break-inside: avoid;
    }
    .content pre code { background: none; color: #e2e8f0; padding: 0; font-size: 12px; line-height: 1.6; }
    .mermaid {
      background: #ffffff; border: 1px solid #e2e8f0;
      border-radius: 8px; padding: 22px 14px;
      margin: 14px 0; text-align: center; break-inside: avoid;
    }
    .mermaid svg { max-width: 100% !important; max-height: 205mm; height: auto; width: auto; }
    .content img { max-width: 100%; max-height: 220mm; }
    .content .md-h2, .content .md-h3, .content .md-h4 { break-after: avoid; }
    .content .md-toc { border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 16px; margin: 0 0 18px; break-inside: avoid; }
    .content .md-toc ul { list-style: none; padding-left: 0; margin: 0; }
    .content .md-toc ul ul { padding-left: 14px; }
    .content .md-toc li { margin: 1px 0; font-size: 12px; }
    .content .md-toc a { color: #4a5568; }
    .content input[type="checkbox"] { margin-right: 5px; }
  </style>
</head>
<body>

  {{if .ShowCover}}
  <!-- PORTADA (se imprime aparte, sin pie de página) -->
  <div class="cover">
    <div class="cover-logo"><img src="/logo.svg" alt="{{.Brand.CompanyName}}"></div>
    <div class="cover-company">{{.Brand.CompanyName}}</div>
    <div class="cover-title">{{.Brand.DocsTitle}}</div>
    {{if .Brand.Description}}<div class="cover-description">{{.Brand.Description}}</div>{{end}}
    <div class="cover-line"></div>
    <div class="cover-date">{{.Date}}</div>
    {{if .Brand.PoweredBy}}
    <div class="cover-powered">Powered by {{with .Brand.PoweredByLink}}<a href="{{.}}">{{$.Brand.PoweredByLabel}}</a>{{else}}{{.Brand.PoweredByLabel}}{{end}}</div>
    {{end}}
  </div>

  {{end}}

  {{if .ShowBody}}
  <!-- ÍNDICE: enlaces internos + número de página (se rellena en la 2ª pasada) -->
  <nav class="toc-page" aria-label="Índice">
    <h1 class="toc-heading" id="toc">Índice</h1>
    {{range $i, $s := .Sections}}
    <div class="toc-doc">
      <a class="toc-item" href="#{{$s.Anchor}}">
        <span class="toc-num">{{printf "%02d" (add $i 1)}}</span>
        <span class="toc-info">
          <span class="toc-title">{{$s.Doc.Title}}</span>
          {{if $s.Doc.Subtitle}}<span class="toc-subtitle">{{$s.Doc.Subtitle}}</span>{{end}}
        </span>
        <span class="toc-dots"></span>
        <span class="toc-pg" data-page-of="{{$s.Anchor}}"></span>
      </a>
      {{if $s.TOC}}
      <div class="toc-sub">
        {{range $s.TOC}}
        <a class="toc-sub-item lvl-{{.Level}}" href="#{{.Anchor}}">
          <span>{{.Text}}</span>
          <span class="toc-dots"></span>
          <span class="toc-pg" data-page-of="{{.Anchor}}"></span>
        </a>
        {{end}}
      </div>
      {{end}}
    </div>
    {{end}}
  </nav>

  <!-- DOCUMENTOS: cada uno es un H1 (nivel 1 de los marcadores del PDF) -->
  {{range .Sections}}
  <section class="doc-section">
    <header class="doc-header">
      <div>
        <h1 class="doc-header-title" id="{{.Anchor}}">{{.Doc.Title}}</h1>
        {{if .Doc.Subtitle}}<div class="doc-header-subtitle">{{.Doc.Subtitle}}</div>{{end}}
      </div>
      <a class="doc-header-back" href="#toc">↑ Índice</a>
    </header>
    <div class="content">{{.Content}}</div>
  </section>
  {{end}}
  {{end}}

  <script>
    mermaid.initialize({
      startOnLoad: false, theme: 'neutral',
      securityLevel: 'loose',
      flowchart: { useMaxWidth: true, htmlLabels: true },
      sequence: { useMaxWidth: true }
    });
    document.addEventListener('DOMContentLoaded', async function() {
      document.querySelectorAll('pre code.language-mermaid').forEach(function(block) {
        var pre = block.parentElement;
        var div = document.createElement('div');
        div.className = 'mermaid';
        div.textContent = block.textContent || '';
        if (pre && pre.parentNode) pre.parentNode.replaceChild(div, pre);
      });
      await mermaid.run();
      window.__mermaidDone = true;
    });
  </script>
</body>
</html>
